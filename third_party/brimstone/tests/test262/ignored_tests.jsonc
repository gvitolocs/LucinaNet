      "staging/sm/regress/regress-602621.js",
      "staging/sm/Set/symmetric-difference.js",
      "staging/sm/Set/union.js",
      "staging/sm/statements/regress-642975.js",
      "staging/sm/strict/strict-function-statements.js",
      "staging/sm/String/internalUsage.js",
      "staging/sm/TypedArray/set-detached.js",

      // Throw an unexpected TypeError
      "staging/sm/Atomics/cross-compartment.js",
      "staging/sm/class/superPropOrdering.js",
      "staging/sm/Date/setTime-argument-shortcircuiting.js",
      "staging/sm/extensions/arguments-property-access-in-function.js",
      "staging/sm/extensions/censor-strict-caller.js",
      "staging/sm/extensions/function-caller-skips-eval-frames.js",
      "staging/sm/extensions/function-properties.js",
      "staging/sm/Function/function-caller-restrictions.js",
      "staging/sm/Function/function-toString-builtin-name.js",
      "staging/sm/Iterator/prototype/lazy-methods-return-closes-iterator.js",
      "staging/sm/lexical-environment/block-scoped-functions-annex-b-with.js",
      "staging/sm/misc/explicit-undefined-optional-argument.js",
      "staging/sm/RegExp/constructor-ordering.js",
      "staging/sm/RegExp/flags-param-handling.js",
      "staging/sm/RegExp/match-local-tolength-recompilation.js",
      "staging/sm/RegExp/replace-compile-elembase.js",
      "staging/sm/RegExp/replace-compile.js",
      "staging/sm/RegExp/replace-local-tolength-recompilation.js",
      "staging/sm/regress/regress-577648-1.js",
      "staging/sm/regress/regress-577648-2.js",
      "staging/sm/regress/regress-584355.js",
      "staging/sm/regress/regress-586482-1.js",
      "staging/sm/regress/regress-586482-2.js",
      "staging/sm/regress/regress-586482-3.js",
      "staging/sm/regress/regress-586482-4.js",
      "staging/sm/regress/regress-586482-5.js",
      "staging/sm/String/matchAll.js",
      "staging/sm/syntax/linefeed-at-eof-in-unterminated-string-or-template.js",

      // Parse/reject behaviour differs (unexpected SyntaxError)
      "staging/sm/fields/await-identifier-module-2.js",
      "staging/sm/Function/function-name-for.js",
      "staging/sm/lexical-environment/block-scoped-functions-annex-b-if.js",
      "staging/sm/lexical-environment/block-scoped-functions-annex-b-label.js",
      "staging/sm/lexical-environment/block-scoped-functions-annex-b-parameter.js",
      "staging/sm/lexical-environment/block-scoped-functions-deprecated-redecl.js",
      "staging/sm/lexical-environment/var-in-catch-body-annex-b-eval.js",
      "staging/sm/module/await-restricted-nested.js",
      "staging/sm/RegExp/unicode-braced.js",
      "staging/sm/syntax/declaration-forbidden-in-label.js",

      // Throw an unexpected RangeError
      "staging/sm/String/fromCodePoint.js",

      // Fail with no distinctive engine message
      "staging/sm/Function/constructor-binding.js",
      "staging/sm/lexical-environment/block-scoped-functions-annex-b-eval.js",
      "staging/sm/lexical-environment/block-scoped-functions-annex-b.js",
      "staging/sm/lexical-environment/block-scoped-functions-annex-b-notapplicable.js",
      "staging/sm/Math/acosh-approx.js",
      "staging/sm/Math/atanh-approx.js",

      // Panic inside the engine
      "staging/sm/RegExp/7.8.5-01.js",

      // Exceed the 60 s per-test budget in release and debug
      "staging/sm/regress/regress-1507322-deep-weakmap.js",

      // kills the harness process (huge BigInt shift allocation via num-bigint)
      "staging/sm/BigInt/large-bit-length.js",

      // debug timeout only: every release run passed (x5), the debug binary exceeds the 60 s
      // per-test budget (it needs 93-111 s where release needs about 3 s)
      "staging/sm/Date/dst-offset-caching-6-of-8.js",
      "staging/sm/Date/dst-offset-caching-8-of-8.js",

      // debug fail only: every release run passed (x5), the debug binary raises a RangeError; a real
      // difference between the profiles, not yet investigated
      "staging/sm/class/superPropChains.js",

      ////////////////////////////////////////
      //
      // Known divergences (Do not plan on fixing)
      //
      ////////////////////////////////////////

      // Test includes annex-B features (named backreference in a RegExp with no named capture groups)
      "built-ins/String/prototype/split/separator-regexp.js",

      // Calls to properties of the target object of a `with` statement must use the target object
      // as the receiver.
      "language/expressions/call/with-base-obj.js",

      // The errors returned from a derived constructor's [[Construct]] if the constructor's
      // return value is invalid or uninitialized must be in the callee's realm.
      "built-ins/Function/internals/Construct/derived-this-uninitialized-realm.js",

      // Does not evaluate ToPropertyKey in key of object destructuring before evaluating the RHS
      "language/destructuring/binding/keyed-destructuring-property-reference-target-evaluation-order-with-bindings.js",

      // Does not evaluate LHS of assignment to reference before evaluating the RHS, when RHS can modify reference
      "language/identifier-resolution/assign-to-global-undefined.js",
      "language/statements/variable/binding-resolution.js"
    ],
    "features": [
      // Tail call optimizations are not implemented. Always skip tail-call-optimization tests as
      // they cause stack overflow.
      "tail-call-optimization"
    ]
  },
  // Tests for unimplemented features. Counts against test262 progress.
  "unimplemented": {
    "features": [
      // Stage 4 proposals which need to be implemented
      "explicit-resource-management",
      "joint-iteration",

      // Other unimplemented features
      "SharedArrayBuffer",
      "Atomics",
      "Atomics.pause"
    ]
  },
  // Tests for features that are not part of the standard. These tests are always ignored, and do
  // not count against test262 progress.
  //
  // This includes tests for:
  // - Stage < 4 proposals
  // - Annex B (Additional ECMAScript Features for Web Browsers)
  // - Non-standard extensions to the language
  // - Standards other than ECMA-262
  "non_standard": {
    "tests": [
      // Annex B
      "annexB/*",

      // The ECMA-402 Internationalization API is not part of ECMA-262
      "intl402/*"
    ],
    "features": [
      // Non-standard extensions
      "caller",

      // Stage < 4 proposals
      "await-dictionary",
      "decorators",
      "error-stack-accessor",
      "import-defer",
      "import-text",
      "immutable-arraybuffer",
      "legacy-regexp",
      "nonextensible-applies-to-private",
      "source-phase-imports",
      "FinalizationRegistry.prototype.cleanupSome",
      "Intl.DurationFormat",
      "Intl.Locale-info",
      "Intl.NumberFormat-v3",
      "ShadowRealm"
    ]
  },
