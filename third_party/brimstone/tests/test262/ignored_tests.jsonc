{
  // Tests that are known to fail but should count against test262 progress.
  "known_failures": {
    "tests": [
      ////////////////////////////////////////
      //
      // Bugs (We intend to fix these)
      //
      ////////////////////////////////////////

      // Introduced SpiderMonkey tests that still fail today, measured per file with every ignore
      // list empty: release passes 1, 3 and 4 plus debug pass 2 (an earlier change, 2026-11-17).
      // The former "staging/sm/*" glob covered these 80 files plus 1329 that now pass, and a file
      // was dropped only when all four of its runs passed. Grouped by the failing run's message.

      // Fail the assertion machinery (Test262Error)
      "staging/sm/Atomics/detached-buffers.js",
      "staging/sm/class/strictExecution.js",
      "staging/sm/Date/non-iso.js",
      "staging/sm/Error/constructor-proto.js",
