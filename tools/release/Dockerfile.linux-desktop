# LucinaNet Linux x86_64 desktop build base.
# Debian 12 = glibc 2.36, so the binary needs nothing newer than GLIBC_2.36 and starts on Ubuntu 22.04+, Debian 12+, Fedora 38+.
# Only the toolchain and build deps live in the image; the release job mounts the source and the cargo directories when it runs the container.
# Toolchain version follows rust-toolchain.toml.
FROM debian:12
ARG RUST_TOOLCHAIN=1.99.1
# rustup-init is pinned by version and checked against a recorded sha256. The hash is the content of
# https://static.rust-lang.org/rustup/archive/1.29.3/x86_64-unknown-linux-gnu/rustup-init.sha256 (rustup 1.29.3, the stable
# release named by https://static.rust-lang.org/rustup/release-stable.toml on 2026-11-19), confirmed by sha256sum of a download.
ARG RUSTUP_VERSION=1.29.3
ARG RUSTUP_INIT_SHA256=b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55
ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/opt/rustup \
    PATH=/opt/rustup-bin:/usr/bin:/bin:/usr/sbin:/sbin
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git pkg-config cmake make \
      clang libclang-dev python3 binutils \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/rustup-bin \
    && curl -sSfo /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
    && echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && CARGO_HOME=/opt/cargo-home /tmp/rustup-init -y --profile minimal --default-toolchain ${RUST_TOOLCHAIN} --no-modify-path \
    && rm /tmp/rustup-init \
    && ln -s /opt/cargo-home/bin/* /opt/rustup-bin/
